# Copy to .env and fill in. Every value below is a placeholder.
# .env is git-ignored. Never commit real keys.

# ---------------------------------------------------------------
# engine/ (control plane, Node.js)
# ---------------------------------------------------------------
# Where the engine writes logs, reports, workflows and the event ledger.
# Default: ./data at the repo root.
FLOWSTACK_HOME=./data
# Optional overrides (both default to FLOWSTACK_HOME)
# FLOWSTACK_ROOT=
# FLOWSTACK_WORKSPACE_ROOT=

# Control plane API
CONTROL_PLANE_API_TOKEN=change-me
CONTROL_PLANE_API_PORT=47911

# Demo mode (1 = no live mutation)
FLOWSTACK_DEMO_MODE=1

# Optional LLM repair path (off by default). Points at a LiteLLM proxy.
ENABLE_LLM_REPAIR=0
LITELLM_BASE=http://127.0.0.1:4000
LITELLM_URL=http://127.0.0.1:4000/chat/completions
LITELLM_MODEL=your-model-alias
LITELLM_KEY=

# n8n (only needed for the live dispatch path)
N8N_URL=http://localhost:5678
N8N_API_KEY=

# ---------------------------------------------------------------
# sales/ (Vite + React app and Vercel API handlers)
# ---------------------------------------------------------------
# Airtable
FLOWSTACK_AIRTABLE_PAT=
FLOWSTACK_AIRTABLE_BASE_ID=

# LLM (Groq): proposal polish and the chatbot
GROQ_API_KEY=

# Email (Resend)
RESEND_API_KEY=
FLOWSTACK_SALES_EMAIL_TO=sales@sampletours.example
FLOWSTACK_SALES_EMAIL_FROM=noreply@sampletours.example

# Client portal / discovery access
PORTAL_TOKENS={"replace-with-a-long-random-token":"sampletours_samplecity"}
PORTAL_ACCESS_TOKEN=
PORTAL_TENANT_ID=sampletours_samplecity
PORTAL_ALLOWED_ORIGIN=http://localhost:3000
OPERATOR_KEY=
DISCOVERY_TOKENS={"replace-with-a-long-random-token":"sampletours_samplecity"}
DISCOVERY_ACCESS_TOKEN=
DISCOVERY_TENANT_ID=sampletours_samplecity

# Facebook Messenger webhook
FB_VERIFY_TOKEN=
FB_PAGE_ACCESS_TOKEN=

# ---------------------------------------------------------------
# sales/ test scripts
# ---------------------------------------------------------------
BASE_URL=http://localhost:3000
SKIP_EXTERNAL=true
TIMEOUT_MS=12000
